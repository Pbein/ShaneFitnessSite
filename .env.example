# Sanity CMS — Train Shane site (Phase 2A)
# Copy to .env.local and fill in real values. .env.local is gitignored.
# The NEXT_PUBLIC_* vars are safe to expose (they ship to the browser).
# SANITY_API_READ_TOKEN is a server-only secret — never commit it.

NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-01-01
SANITY_API_READ_TOKEN=
